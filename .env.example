# Copy this file to .env and fill in the values. .env is gitignored:
# never commit real credentials.

# Root URL of an OpenAI-compatible API, WITHOUT /v1: the client calls
# {BASE_URL}/v1/chat/completions. Works with OpenAI itself, a LiteLLM proxy,
# vLLM, and similar.
BASE_URL=

# Bearer token for that API.
MODEL_API_KEY=

# PostgreSQL connection URL. Only needed for persistence and the full test suite.
# Example shape: postgresql://user:password@localhost:5432/agentsdk
DATABASE_URL=

# Model id used when an agent does not name one. Leave empty for openai.gpt-4o-mini.
DEFAULT_MODEL=

# OTLP/HTTP collector that scripts/13_telemetry.py sends spans to in live mode, for
# example a local Jaeger: http://localhost:4318. The SDK itself never reads it.
OTEL_EXPORTER_OTLP_ENDPOINT=
